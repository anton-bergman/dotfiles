{
  "mcpServers": {
    "sellpy-knowledge-wiki": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://knowledge-wiki-worker.johan-e93.workers.dev/mcp"
      ]
    },
    "bigquery": {
      "type": "http",
      "url": "https://services.dev.sellpy.net/litellm/mcp",
      "headers": {
        "x-litellm-api-key": "Bearer ${SELLPY_AI_GATEWAY_KEY}",
        "x-mcp-servers": "BigQuery"
      }
    },
    "linear": {
      "type": "http",
      "url": "https://services.dev.sellpy.net/litellm/mcp",
      "headers": {
        "x-litellm-api-key": "Bearer ${SELLPY_AI_GATEWAY_KEY}",
        "x-mcp-servers": "linear"
      }
    },
    "betterstack": {
      "type": "http",
      "url": "https://services.dev.sellpy.net/litellm/mcp",
      "headers": {
        "x-litellm-api-key": "Bearer ${SELLPY_AI_GATEWAY_KEY}",
        "x-mcp-servers": "betterstack"
      }
    },
    "redash": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://redash-mcp-worker.johan-e93.workers.dev/mcp"
      ]
    }
  }
