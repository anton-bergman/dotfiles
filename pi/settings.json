{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/schemas/settings.json",
  "theme": "dark",
  "externalEditor": "nvim",
  "quietStartup": false,
  "tuiMode": "regular",
  "defaultProjectTrust": "ask",
  "enableInstallTelemetry": false,
  "enableAnalytics": false,
  "npmCommand": ["mise", "exec", "node@lts", "--", "npm"],
  "showHardwareCursor": true,
  "packages": [
    "~/dotfiles/pi/packages/plan-build",
    "~/dotfiles/pi/packages/copy-code",
    "~/dotfiles/pi/packages/sellpy-ai-gateway",
    "npm:@gotgenes/pi-permission-system@40.0.2",
    "npm:pi-web-access@0.37.0"
  ],
  "skills": ["~/.config/agents/skills", "~/.config/agents/skills/local"],
  "enableSkillCommands": true,
  "defaultProvider": "google",
  "defaultModel": "gemini-3.8-flash",
  "defaultThinkingLevel": "medium",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3
  },
  "hideThinkingBlock": true,
  "lastChangelogVersion": "1.2.0"
}
